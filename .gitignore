# Dependencias
node_modules/

# Resultados de construccion
dist/
build/
coverage/

# Registros y temporales
*.log
npm-debug.log*
.cache/
.tmp/
*.tmp

# Repositorios que las semillas dejan preparados. El destino por omision de
# `semillas/preparar.sh` es ./recetario, y quien lo corra desde la raiz del
# curso no deberia ver un repositorio ajeno asomando en `git status`.
recetario/

# El trabajo del participante dentro de cada laboratorio. Los laboratorios son
# carpetas autocontenidas: quien haga el lab 01 crea `labs/lab-01/recetario` y
# ese repositorio es suyo, no del curso. La regla de arriba ya lo cubre por ser
# un patron sin anclar, pero esta queda explicita para que anclar aquella no se
# lleve por delante, en silencio, el trabajo de la clase.
labs/*/recetario/

# Editores
.vscode/
.idea/
*.swp

# Sistema operativo
.DS_Store
Thumbs.db
