{
  "name": "simulador-git-sii",
  "private": true,
  "version": "1.0.0",
  "description": "Simulador visual de Git para el taller del Servicio de Impuestos Internos",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node herramientas/manifiesto.mjs --escribir",
    "lint": "biome lint",
    "capturas": "node herramientas/capturas.mjs",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:observar": "vitest",
    "tipos": "tsc --noEmit",
    "comprobar": "node herramientas/manifiesto.mjs --comprobar",
    "e2e": "npm run build && cypress run",
    "e2e:abrir": "cypress open --e2e"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "cypress": "^16.0.0",
    "playwright": "^1.56.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.0"
  }
}
